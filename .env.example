# ============================================================================
# CONFIGURAÇÃO DO EPUB TO MP3 CONVERTER
# ============================================================================
# Copie este arquivo para .env e preencha com suas configurações

# ============================================================================
# TELEGRAM BOT (Opcional - somente se for usar o bot)
# ============================================================================
# Token do bot do Telegram (obtenha com @BotFather)
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# ============================================================================
# WEB SERVER (FastAPI)
# ============================================================================
# URL do frontend (Cloudflare Pages ou localhost)
# FRONTEND_URL=https://seu-app.pages.dev

# URL do Cloudflare Pages (configurado automaticamente pelo Railway)
# CLOUDFLARE_PAGES_URL=https://seu-app.pages.dev

# Porta do servidor (Railway define automaticamente via $PORT)
# PORT=8000

# ============================================================================
# RAILWAY DEPLOYMENT
# ============================================================================
# Estas variáveis são configuradas automaticamente pelo Railway:
# - PORT (porta do servidor)
# - RAILWAY_ENVIRONMENT (production/staging)
# - RAILWAY_PROJECT_NAME
# - RAILWAY_SERVICE_NAME

# ============================================================================
# TTS ENGINE (Configurações opcionais)
# ============================================================================
# Engine padrão: edge, coqui, piper
# DEFAULT_TTS_ENGINE=edge

# Voz padrão para Edge-TTS
# DEFAULT_EDGE_VOICE=pt-BR-ThalitaMultilingualNeural

# Caminho para modelos Piper (se usar Piper TTS)
# PIPER_MODELS_DIR=./python_app/models

# ============================================================================
# CACHE E STORAGE
# ============================================================================
# Diretório de cache (padrão: .cache)
# CACHE_DIR=.cache

# Diretório de output (padrão: output)
# OUTPUT_DIR=output

# Diretório temporário para uploads do Telegram (padrão: temp_telegram)
# TEMP_DIR=temp_telegram

# ============================================================================
# CLOUDFLARE R2 STORAGE (Opcional - para persistência de arquivos)
# ============================================================================
# IMPORTANTE: Railway tem storage efêmero (arquivos deletados após restart)
# Configure R2 para armazenamento persistente e downloads via web

# Cloudflare Account ID (Dashboard > R2 > Overview)
# R2_ACCOUNT_ID=abc123def456

# R2 Access Key ID e Secret (Dashboard > R2 > Manage R2 API Tokens)
# R2_ACCESS_KEY_ID=your_access_key_id
# R2_SECRET_ACCESS_KEY=your_secret_access_key

# Nome do bucket R2 (padrão: epub-to-mp3)
# R2_BUCKET_NAME=epub-to-mp3

# URL pública do bucket (se configurado custom domain ou R2.dev)
# Exemplo: https://pub-xxxxx.r2.dev ou https://files.seudominio.com
# R2_PUBLIC_URL=https://pub-xxxxx.r2.dev

# ⚠️ Se não configurar R2, arquivos ficam apenas localmente (perdidos após restart Railway)

# ============================================================================
# DESENVOLVIMENTO
# ============================================================================
# Modo debug (true/false)
# DEBUG=false

# Log level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO
