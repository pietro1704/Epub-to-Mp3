**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Generated by scripts/bootstrap-android-python.sh — mirror of python_app/src/
# for Chaquopy. Do not edit; re-run the script if you need to refresh it.
/android/app/src/main/python/

# Generated by scripts/bootstrap-desktop-python.sh — mirror of
# python_app/src/ shipped as a Flutter asset for Linux/Windows desktop.
# Keep the empty directory tracked via .gitkeep so `flutter analyze` on
# a fresh checkout does not warn "asset_directory_does_not_exist" before
# the bootstrap script has had a chance to populate it.
/assets/python_app/**
!/assets/python_app/src/.gitkeep
!/assets/python_app/
!/assets/python_app/src/
