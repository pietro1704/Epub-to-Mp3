{
  "name": "ebook-tts-web",
  "version": "0.5.8",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npx tsc --noEmit -p tsconfig.build.json && vite build",
    "build:desktop": "npx tsc --noEmit -p tsconfig.build.json && vite build --mode desktop",
    "build:mobile": "npx tsc --noEmit -p tsconfig.build.json && vite build --mode mobile && npx cap sync",
    "build:mobile:bundle": "npx tsc --noEmit -p tsconfig.build.json && vite build --mode mobile",
    "preview": "vite preview",
    "lint": "eslint --max-warnings=0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:dependency-security && NODE_OPTIONS='--max-old-space-size=4096' vitest run",
    "test:dependency-security": "node --test scripts/minimatch.node-tests.mjs scripts/zod.node-tests.mjs",
    "test:watch": "vitest",
    "cap:ios": "npx cap open ios",
    "cap:android": "npx cap open android",
    "predev": "node scripts/prepare-tts-runtime.mjs",
    "prebuild": "node scripts/prepare-tts-runtime.mjs",
    "prebuild:desktop": "node scripts/prepare-tts-runtime.mjs",
    "prebuild:mobile:bundle": "node scripts/prepare-tts-runtime.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@diffusionstudio/piper-wasm": "1.0.0",
    "@mintplex-labs/piper-tts-web": "1.0.5",
    "clsx": "^2.1.1",
    "onnxruntime-web": "1.31.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "overrides": {
    "undici": "^8.12.4",
    "@babel/core": "^7.29.6",
    "brace-expansion": "5.0.12",
    "eslint": {
      "minimatch": "11.0.5"
    },
    "@eslint/config-array": {
      "minimatch": "11.0.5"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.5"
    }
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-react": "^6.3.0",
    "baseline-browser-mapping": "^2.11.35",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "terser": "^5.51.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=26.13.0 <27",
    "npm": ">=12.2.2 <13"
  },
  "packageManager": "npm@12.2.2"
}
