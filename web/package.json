{
  "name": "ebook-tts-web",
  "version": "0.5.8",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npx tsc --noEmit -p tsconfig.build.json && vite build",
    "build:desktop": "npx tsc --noEmit -p tsconfig.build.json && vite build --mode desktop",
    "build:mobile": "npx tsc --noEmit -p tsconfig.build.json && vite build --mode mobile && npx cap sync",
    "build:mobile:bundle": "npx tsc --noEmit -p tsconfig.build.json && vite build --mode mobile",
    "preview": "vite preview",
    "lint": "eslint --max-warnings=0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "NODE_OPTIONS='--max-old-space-size=4096' vitest run",
    "test:watch": "vitest",
    "cap:ios": "npx cap open ios",
    "cap:android": "npx cap open android",
    "predev": "node scripts/prepare-tts-runtime.mjs",
    "prebuild": "node scripts/prepare-tts-runtime.mjs",
    "prebuild:desktop": "node scripts/prepare-tts-runtime.mjs",
    "prebuild:mobile:bundle": "node scripts/prepare-tts-runtime.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8",
    "@capacitor/core": "^8",
    "@capacitor/ios": "^8",
    "@diffusionstudio/piper-wasm": "1.0.0",
    "@mintplex-labs/piper-tts-web": "1.0.5",
    "clsx": "^2.1.0",
    "onnxruntime-web": "1.30.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "overrides": {
    "undici": "^7.30.0",
    "@babel/core": "^7.29.6",
    "uuid": "11.1.1",
    "brace-expansion": "5.0.12"
  },
  "devDependencies": {
    "@capacitor/cli": "^8",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitejs/plugin-react": "^6.1.1",
    "baseline-browser-mapping": "^2.11.29",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "terser": "^5.51.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
