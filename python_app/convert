#!/usr/bin/env python3
"""Dedicated CLI entry that defaults to the `convert` command."""

import argparse
import difflib
import os
import re
import sys
import unicodedata
from pathlib import Path

CURRENT_DIR = Path(__file__).resolve().parent
PROJECT_ROOT = CURRENT_DIR.parent
if str(PROJECT_ROOT) not in sys.path:
    sys.path.insert(0, str(PROJECT_ROOT))
if str(CURRENT_DIR) not in sys.path:
    sys.path.insert(0, str(CURRENT_DIR))

from src.ui.prompt import TerminalPrompt

from main import (
    ConverterApplication,
    _add_conversion_arguments,
    argcomplete,
)

SUPPORTED_EXTENSIONS = {".epub", ".pdf"}


_FUZZY_SEARCH_DIRS = (Path.home() / "Downloads", Path.cwd())


def _norm_tokens(text: str) -> list[str]:
    """Lowercase, strip accents, split on non-alphanumerics."""
    text = unicodedata.normalize("NFKD", text)
    text = "".join(c for c in text if not unicodedata.combining(c))
    return [t for t in re.split(r"[^a-z0-9]+", text.lower()) if t]


def _fuzzy_find_book(query: str) -> Path | None:
    """Search common directories for a book whose filename fuzzy-matches query tokens.

    Returns the best match if score is high enough, else None.
    """
    query_tokens = _norm_tokens(query)
    if not query_tokens:
        return None

    best: tuple[float, Path] | None = None
    seen: set[Path] = set()
    for base in _FUZZY_SEARCH_DIRS:
        if not base.exists() or not base.is_dir():
            continue
        try:
            candidates = [
                p for p in base.iterdir()
                if p.is_file() and p.suffix.lower() in SUPPORTED_EXTENSIONS
            ]
        except OSError:
            continue
        for cand in candidates:
            if cand in seen:
                continue
            seen.add(cand)
            fname_tokens = _norm_tokens(cand.stem)
            if not fname_tokens:
                continue
            matched = 0
            for qt in query_tokens:
                if len(qt) < 2:
                    continue
                ratios = [difflib.SequenceMatcher(None, qt, ft).ratio() for ft in fname_tokens]
                if ratios and max(ratios) >= 0.75:
                    matched += 1
            score = matched / max(1, len([t for t in query_tokens if len(t) >= 2]))
            if score >= 0.6 and (best is None or score > best[0]):
                best = (score, cand)
    return best[1] if best else None


def _collect_files_from_path(path: Path) -> list[str]:
    if not path.exists():
        return []
    if path.is_file():
        return [str(path)]
    if path.is_dir():
        files = sorted(
            child
            for child in path.rglob("*")
            if child.is_file() and child.suffix.lower() in SUPPORTED_EXTENSIONS
        )
        return [str(child) for child in files]
    return []


def _normalize_cli_args(raw_args: list[str]) -> list[str]:
    """Join space-split file paths back into a single argument when possible."""
    if not raw_args:
        return raw_args

    # If the first token is an option we can't infer a path
    if raw_args[0].startswith("-"):
        return raw_args

    result: list[str] = []
    tokens: list[str] = []
    consumed = 0
    detected_path: str | None = None

    for idx, token in enumerate(raw_args):
        if token.startswith("--") and tokens:
            break
        if token.startswith("-") and not Path(token).suffix:
            break
        tokens.append(token)
        candidate = " ".join(tokens)
        expanded = Path(candidate).expanduser()
        if expanded.exists():
            detected_path = str(expanded)
            consumed = idx + 1
            break

    if detected_path is None and tokens:
        detected_path = " ".join(tokens)
        consumed = len(tokens)

    if detected_path:
        result.append(detected_path)

    result.extend(raw_args[consumed:])
    return result if result else raw_args


def main() -> int:
    parser = argparse.ArgumentParser(
        description="EBook to Audiobook Converter",
        formatter_class=argparse.ArgumentDefaultsHelpFormatter,
        epilog=(
            "Example:\n"
            "  book=$(find \"$HOME/Downloads\" -maxdepth 1 -iname '*jardim*' -print -quit)\n"
            "  python python_app/convert \"$book\" --engine piper --model "
            "python_app/models/pt_BR-faber-medium.onnx --chapter 1"
        ),
    )
    _add_conversion_arguments(parser, include_menu_flag=False, input_required=False)
    parser.add_argument(
        "-y",
        "--yes",
        action="store_true",
        help="Assume yes for all prompts when clearing cache",
    )
    parser.add_argument(
        "--menu",
        action="store_true",
        help="Launch interactive menu before converting",
    )

    if argcomplete is not None:
        argcomplete.autocomplete(parser)

    normalized_args = _normalize_cli_args(sys.argv[1:])
    args = parser.parse_args(normalized_args)

    if not hasattr(args, "extra_inputs"):
        args.extra_inputs = []
    if not hasattr(args, "batch_inputs") or args.batch_inputs is None:
        args.batch_inputs = []
    if not hasattr(args, "batch_manifest"):
        args.batch_manifest = None
    if not hasattr(args, "batch_stop_on_error"):
        args.batch_stop_on_error = False

    expanded_inputs: list[str] = []
    original_inputs: list[str] = []
    if getattr(args, "input_file", None):
        original_inputs.append(args.input_file)
    original_inputs.extend(args.extra_inputs or [])

    for entry in original_inputs:
        expanded = _collect_files_from_path(Path(entry).expanduser())
        if not expanded:
            # Fuzzy fallback: user may have typed a partial/misspelled book name
            # like "downloads o loudo de deus" — search ~/Downloads and CWD.
            match = _fuzzy_find_book(entry)
            if match is not None:
                print(f"🔎 Fuzzy match: {entry!r} -> {match}")
                expanded = [str(match)]
        if expanded:
            expanded_inputs.extend(expanded)
        else:
            print(f"[warn] nenhum EPUB/PDF encontrado em: {entry}")

    if expanded_inputs:
        args.input_file = expanded_inputs[0]
        args.extra_inputs = expanded_inputs[1:]
    else:
        args.input_file = None
        args.extra_inputs = []

    has_input = bool(getattr(args, "input_file", None) or args.extra_inputs)
    has_batch = bool(args.batch_inputs) or bool(args.batch_manifest)

    if args.clear_cache and not has_input and not has_batch:
        _clear_cache_all(assume_yes=args.yes)
        return 0

    if args.menu and not has_input and not has_batch:
        parser.error("--menu requires an EPUB or PDF input file")

    if not has_input and not has_batch:
        parser.print_help()
        return 1

    args.command = "convert"
    if not hasattr(args, "chapters"):
        args.chapters = []
    if not hasattr(args, "sections"):
        args.sections = []

    if not hasattr(args, "menu"):
        args.menu = False

    app = ConverterApplication(ui_language=getattr(args, "ui_language", None))
    try:
        return app.run(args)
    except KeyboardInterrupt:
        print("\n🛑 Conversão interrompida pelo usuário (CTRL+C).")
        return 130


def _clear_cache_all(*, assume_yes: bool = False) -> None:
    from src.cache_manager import CacheManager
    cache_manager = CacheManager()
    cache_dir = cache_manager.cache_dir
    if not cache_dir.exists() or not any(cache_dir.iterdir()):
        print("No cache directory found.")
        return

    if not assume_yes:
        if not sys.stdin.isatty():
            print("Run with --clear-cache -y to skip confirmation in non-interactive mode.")
            return

        prompt = TerminalPrompt()
        try:
            answer = prompt.ask(
                "Remove all cached audio/text files? [y/N]: ",
                valid={"y", "n", "yes", "no"},
                default="n",
                allow_blank_default=True,
            )
        except EOFError:
            answer = None

        if not answer:
            print("Cache clear aborted.")
            return

        if answer.lower() not in {"y", "yes"}:
            print("Cache clear aborted.")
            return

    try:
        removed = cache_manager.clear_cache()
        if removed:
            print("Cache directory cleared.")
        else:
            print("No cached files were removed.")
    except OSError as exc:
        print(f"Failed to clear cache: {exc}")


if __name__ == "__main__":
    sys.exit(main())
