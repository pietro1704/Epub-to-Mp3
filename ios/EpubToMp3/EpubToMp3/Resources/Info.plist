<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Backend may run on http://localhost:8000 (mise run web) or
		     a private LAN IP — bypass ATS for loopback/.local only. -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<!-- Reader WebView renders EPUB chapter HTML extracted from the
		     archive: data: / file:// URIs plus inline images. WKWebView
		     enforces ATS otherwise, breaking the in-app reader. -->
		<key>NSAllowsArbitraryLoadsInWebContent</key>
		<true/>
	</dict>
	<!-- Custom launch storyboard. Build setting
	     INFOPLIST_KEY_UILaunchStoryboardName already injects this, but we
	     also pin it in the merged plist to make the launch sequence
	     deterministic across xcodebuild / Xcode IDE / archive flows. -->
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<!-- Edge-TTS conversion is network-intensive; this hints iOS to keep
	     Wi-Fi awake during long jobs instead of dropping the radio. -->
	<key>UIRequiresPersistentWiFi</key>
	<true/>
	<!-- iPadOS trackpad / Magic Mouse hover + scrub support for the
	     player scrubber and library list. -->
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<!-- App ships pt-BR + en-US side-by-side; allow runtime mixing so a
	     pt-BR user on an en-US device still sees localised strings. -->
	<key>CFBundleAllowMixedLocalizations</key>
	<true/>
	<!-- macOS gate matches project.yml deploymentTarget.macOS — keep in
	     sync with that field. -->
	<key>LSMinimumSystemVersion</key>
	<string>11.0</string>
	<!-- Register EpubToMp3 as a system handler for EPUB and PDF. This
	     surfaces the app in:
	       * Apple Books → Share Sheet → Open in EpubToMp3 (only
	         for non-DRM EPUBs the user imported into Books).
	       * Files / Finder → Open With → EpubToMp3.
	       * Safari → downloaded .epub → Open in EpubToMp3.
	     Apple Books purchased content stays inaccessible — Apple
	     enforces FairPlay DRM and never exposes the underlying
	     file to third-party apps. -->
	<!-- App Store: no encryption beyond Apple's standard HTTPS. Avoids
	     the export-compliance review questionnaire on every upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Custom URL scheme for deep-links from widgets, App Intents, and
	     external apps. Handled by `EpubToMp3App.handleIncomingURL(_:)`. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>epubtomp3</string>
			</array>
			<key>CFBundleURLName</key>
			<string>com.pietrocode.epubtomp3</string>
		</dict>
	</array>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>EPUB Book</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>org.idpf.epub-container</string>
				<string>com.apple.ibooks.epub</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>PDF Document</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.adobe.pdf</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
