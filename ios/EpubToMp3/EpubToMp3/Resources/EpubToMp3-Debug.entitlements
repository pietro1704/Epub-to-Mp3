<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Debug builds run unsigned (CODE_SIGN_IDENTITY = "-"), so the
         App Sandbox can't be activated. Without it, we don't need
         security-scoped bookmarks at all — the app reads files like
         any unsandboxed CLI. Release builds use the signed,
         sandboxed entitlements file. -->
    <key>com.apple.security.app-sandbox</key>
    <false/>
</dict>
</plist>
