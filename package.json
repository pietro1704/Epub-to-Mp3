{
  "name": "epub-to-mp3",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm-run-all --parallel dev:backend dev:frontend",
    "dev:backend": "cd python_app && uvicorn server:app --reload --host 0.0.0.0 --port 8000",
    "dev:frontend": "cd web && VITE_API_BASE=http://localhost:8000 npm run dev",
    "build": "./sync_test_fixtures.sh && cd web && npm run build",
    "install:all": "cd web && npm install && cd ../python_app && pip install -r requirements.txt",
    "test": "npm-run-all test:backend test:frontend",
    "test:backend": "cd python_app && pytest",
    "test:frontend": "cd web && npm run test"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
