#!/usr/bin/env bash
set -euo pipefail

git diff --cached --check

# Local commits use read-only gates. Python-based tooling and Ruff belong in CI.
if [[ "${CI:-false}" != "true" ]]; then
    exit 0
fi

if command -v pre-commit >/dev/null 2>&1; then
    pre-commit run --hook-stage pre-commit
else
    echo "pre-commit is unavailable on this CI runner." >&2
    exit 1
fi
