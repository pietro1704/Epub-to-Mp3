# The repository root is the build context. Only the Rust workspace needed for the
# WASM build and the gateway itself are sent to the builder.
*
!Cargo.toml
!Cargo.lock
!crates
!native
!benches
!ruby_app/rails_gateway

**/target
ruby_app/rails_gateway/.bundle
ruby_app/rails_gateway/.env*
ruby_app/rails_gateway/config/master.key
ruby_app/rails_gateway/config/credentials/*.key
ruby_app/rails_gateway/log/*
ruby_app/rails_gateway/tmp/*
ruby_app/rails_gateway/storage/*
!ruby_app/rails_gateway/storage/.keep
ruby_app/rails_gateway/test
ruby_app/rails_gateway/browser_runtime/node_modules
# Generated on the host; the image builds its own from source.
ruby_app/rails_gateway/public/runtime
ruby_app/rails_gateway/public/assets
ruby_app/rails_gateway/config/runtime_manifest.json
