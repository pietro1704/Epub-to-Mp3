# ai-jail sandbox configuration
# https://github.com/akitaonrails/ai-jail
# Edit freely. Regenerate with: ai-jail --clean --init

deny_paths = [
    "**/.env*",
    "ruby_app/rails_gateway/config/credentials.yml.enc",
    "ruby_app/rails_gateway/tmp/local_secret.txt",
]
network = true
no_mise = true
agent_state = true
