<section data-downloads-target="share" hidden aria-label="<%= t("downloadLibrary.shareTitle") %>">
  <h3><%= t("downloadLibrary.shareTitle") %></h3>
  <button type="button" data-action="downloads#nativeShare"><%= t("downloadLibrary.nativeShare") %></button>
  <button type="button" data-action="downloads#whatsApp"><%= t("downloadLibrary.whatsApp") %></button>
  <button type="button" data-action="downloads#copyLink"><%= t("downloadLibrary.copy") %></button>
  <p data-downloads-target="feedback" role="status"></p>
</section>
