#!/usr/bin/env bash
#
# EPUB/PDF to MP3 Audiobook Converter - Turbo Mode
#
# Usage:
#   ./convert book.epub
#   ./convert "path/to/book.pdf"
#   ./convert book.epub --chapter 5
#
# Features:
# - Auto hardware detection & optimization
# - Maximum speed settings (turbo mode)
# - Verbose output enabled
# - Smart engine selection (auto mode)
#

set -euo pipefail  # Exit on error + catch unset vars

MISE_BIN=$(command -v mise || true)
if [ -z "$MISE_BIN" ]; then
    echo "❌ mise não encontrado. Instale mise (https://mise.jdx.dev) para usar ./convert."
    exit 1
fi

VENV_DIR=".venv"
PYTHON_BIN="$VENV_DIR/bin/python"
PIPER_BIN="$VENV_DIR/bin/piper"

# Ensure virtualenv & deps are provisioned via mise
if [ ! -x "$PYTHON_BIN" ] || [ ! -x "$PIPER_BIN" ]; then
    echo "📦 Preparando ambiente com mise (tarefa install)..."
    "$MISE_BIN" run install
fi

# Allow Piper fallback by default (user can override to 0)
export ENABLE_PIPER="${ENABLE_PIPER:-1}"

PYTHON_CMD=("$MISE_BIN" "exec" "--" "python")

# Check if special flags or commands (--help, -h, --version, clear-cache)
if [ "$1" = "--help" ] || [ "$1" = "-h" ] || [ "$1" = "--version" ] || [ "$1" = "clear-cache" ] || [ "$1" = "--clear-cache" ]; then
    "${PYTHON_CMD[@]}" -m python_app.main "$@"
    exit 0
fi

# Check if book path provided
if [ $# -eq 0 ]; then
    echo "❌ Error: No book file specified"
    echo ""
    echo "Usage:"
    echo "  ./convert book.epub"
    echo "  ./convert \"path/to/book.pdf\""
    echo "  ./convert book.epub --chapter 5"
    echo "  ./convert clear-cache                    # Clear all cache"
    echo ""
    exit 1
fi

# Check if file exists
BOOK_PATH="$1"
if [ ! -f "$BOOK_PATH" ]; then
    echo "❌ Error: File not found: $BOOK_PATH"
    exit 1
fi

# Print header
echo "╔════════════════════════════════════════════════════════════╗"
echo "║  🚀 EPUB/PDF TO MP3 CONVERTER - TURBO MODE               ║"
echo "╚════════════════════════════════════════════════════════════╝"
echo ""

# Check which flags are already present
ENGINE_PRESENT=0
VERBOSE_PRESENT=0
for arg in "$@"; do
    case "$arg" in
        --engine|--engine=*)
            ENGINE_PRESENT=1
            ;;
        --verbose|-v)
            VERBOSE_PRESENT=1
            ;;
    esac
done

EXTRA_ARGS=()
# Default to auto engine unless user specified one
if [ "$ENGINE_PRESENT" -eq 0 ]; then
    EXTRA_ARGS+=(--engine auto)
fi
if [ "$VERBOSE_PRESENT" -eq 0 ]; then
    EXTRA_ARGS+=(--verbose)
fi

# Run conversion with optimal settings through mise-managed Python
"${PYTHON_CMD[@]}" -m python_app.main convert "$@" "${EXTRA_ARGS[@]}"

# Print completion
echo ""
echo "╔════════════════════════════════════════════════════════════╗"
echo "║  ✅ CONVERSION COMPLETE!                                  ║"
echo "╚════════════════════════════════════════════════════════════╝"
