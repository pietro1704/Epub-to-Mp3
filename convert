#!/usr/bin/env bash
#
# EPUB/PDF to MP3 Audiobook Converter - Turbo Mode
#
# Usage:
#   ./convert book.epub
#   ./convert "path/to/book.pdf"
#   ./convert book.epub --chapter 5
#
# Features:
# - Auto hardware detection & optimization
# - Maximum speed settings (turbo mode)
# - Verbose output enabled
# - Smart engine selection (auto mode)
#

set -e  # Exit on error

VENV_DIR=".venv"
PYTHON_BIN="$VENV_DIR/bin/python"

# Bootstrap venv if needed (avoids PEP 668 issues on system Python)
if [ ! -x "$PYTHON_BIN" ]; then
    echo "🔧 Criando ambiente virtual em $VENV_DIR..."
    python3 -m venv "$VENV_DIR"
    echo "📦 Instalando dependências em $VENV_DIR..."
    "$PYTHON_BIN" -m pip install --disable-pip-version-check -r python_app/requirements.txt
fi

# Check if special flags or commands (--help, -h, --version, clear-cache)
if [ "$1" = "--help" ] || [ "$1" = "-h" ] || [ "$1" = "--version" ] || [ "$1" = "clear-cache" ] || [ "$1" = "--clear-cache" ]; then
    "$PYTHON_BIN" -m python_app.main "$@"
    exit 0
fi

# Check if book path provided
if [ $# -eq 0 ]; then
    echo "❌ Error: No book file specified"
    echo ""
    echo "Usage:"
    echo "  ./convert book.epub"
    echo "  ./convert \"path/to/book.pdf\""
    echo "  ./convert book.epub --chapter 5"
    echo "  ./convert clear-cache                    # Clear all cache"
    echo ""
    exit 1
fi

# Check if file exists
BOOK_PATH="$1"
if [ ! -f "$BOOK_PATH" ]; then
    echo "❌ Error: File not found: $BOOK_PATH"
    exit 1
fi

# Print header
echo "╔════════════════════════════════════════════════════════════╗"
echo "║  🚀 EPUB/PDF TO MP3 CONVERTER - TURBO MODE               ║"
echo "╚════════════════════════════════════════════════════════════╝"
echo ""

# Check which flags are already present
ENGINE_PRESENT=0
VERBOSE_PRESENT=0
for arg in "$@"; do
    case "$arg" in
        --engine|--engine=*)
            ENGINE_PRESENT=1
            ;;
        --verbose|-v)
            VERBOSE_PRESENT=1
            ;;
    esac
done

EXTRA_ARGS=()
if [ "$ENGINE_PRESENT" -eq 0 ]; then
    EXTRA_ARGS+=(--engine edge)
fi
if [ "$VERBOSE_PRESENT" -eq 0 ]; then
    EXTRA_ARGS+=(--verbose)
fi

# Run conversion with optimal settings; append defaults only when absent
"$PYTHON_BIN" -m python_app.main convert "$@" "${EXTRA_ARGS[@]}"

# Print completion
echo ""
echo "╔════════════════════════════════════════════════════════════╗"
echo "║  ✅ CONVERSION COMPLETE!                                  ║"
echo "╚════════════════════════════════════════════════════════════╝"
