#!/usr/bin/env bash
#
# Convert EPUB/PDF books to MP3 audiobooks with the native Rust CLI.
#
# Usage:
#   ./convert book.epub
#   ./convert "Book title"            # fuzzy lookup in ~/Downloads
#   ./convert book.pdf --chapter 5
#   ./convert --help
#
# Delegates to `mise run convert`, which packages the CLI under the native
# build guard and runs it from the repository root. Existing relative paths
# are made absolute first so they keep resolving from the caller's directory.

set -euo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)

if ! command -v mise >/dev/null 2>&1; then
    echo "mise not found. Install mise (https://mise.jdx.dev) to use ./convert." >&2
    exit 1
fi

arguments=()
literal_value=false
for argument in "$@"; do
    if $literal_value; then
        arguments+=("$argument")
        literal_value=false
        continue
    fi
    # Selectors and provider values are literals even when a local path has
    # the same name. Path-valued options still resolve from the caller's cwd.
    case "$argument" in
        --engine|--fallback-engine|--voice|--fallback-voice|--chapter|--section|--tts-preferences-json|--from-chapter-to-end|--from-chapter-to-chapter|--retry-failed)
            literal_value=true
            ;;
    esac
    if [[ "$argument" != /* && "$argument" != -* && -e "$argument" ]]; then
        argument="$(cd -- "$(dirname -- "$argument")" && pwd)/$(basename -- "$argument")"
    fi
    arguments+=("$argument")
done

cd "$SCRIPT_DIR"
exec mise run convert -- ${arguments[@]+"${arguments[@]}"}
