#!/usr/bin/env bash
#
# EPUB/PDF to MP3 Audiobook Converter - Turbo Mode
#
# Usage:
#   ./convert book.epub
#   ./convert "path/to/book.pdf"
#   ./convert --menu book.epub
#   ./convert book.epub --chapter 5
#
# Features:
# - Auto hardware detection & optimization
# - Maximum speed settings (turbo mode)
# - Verbose output enabled
# - Smart engine selection (auto mode)
#

set -euo pipefail  # Exit on error + catch unset vars

MISE_BIN=$(command -v mise || true)
if [ -z "$MISE_BIN" ]; then
    echo "❌ mise not found. Install mise (https://mise.jdx.dev) to use ./convert."
    exit 1
fi

VENV_DIR=".venv"
PYTHON_BIN="$VENV_DIR/bin/python"
PIPER_BIN="$VENV_DIR/bin/piper"

# Ensure virtualenv & deps are provisioned via mise
if [ ! -x "$PYTHON_BIN" ] || [ ! -x "$PIPER_BIN" ]; then
    echo "📦 Preparing environment with mise (install task)..."
    "$MISE_BIN" run install
fi

# Allow Piper fallback by default (user can override to 0)
export ENABLE_PIPER="${ENABLE_PIPER:-1}"

# Invoke the venv interpreter DIRECTLY rather than `mise exec -- python`.
# `mise exec` resolves the interpreter from the caller's shell/mise state,
# which can point at a stale or mismatched Python (e.g. an interactive shell
# still holding a deleted/old .venv in VIRTUAL_ENV) — that surfaced as
# `ModuleNotFoundError: No module named 'psutil'` even though the freshly
# provisioned .venv had the dep. Using $PYTHON_BIN (validated above) makes the
# wrapper independent of shell state. Fall back to mise exec only if, somehow,
# the venv python is not executable.
if [ -x "$PYTHON_BIN" ]; then
    PYTHON_CMD=("$PYTHON_BIN" "python_app/convert")
else
    PYTHON_CMD=("$MISE_BIN" "exec" "--" "python" "python_app/convert")
fi

if [ $# -eq 0 ]; then
    echo "❌ Error: No arguments provided"
    echo ""
    echo "Usage:"
    echo "  ./convert book.epub"
    echo "  ./convert \"path/to/book.pdf\""
    echo "  ./convert --menu book.epub"
    echo "  ./convert book.epub --chapter 5"
    echo "  ./convert clear-cache                    # Clear all cache"
    echo ""
    exit 1
fi

for arg in "$@"; do
    case "$arg" in
        -h|--help)
            "${PYTHON_CMD[@]}" "$@"
            exit $?
            ;;
    esac
done

if [ "$1" = "clear-cache" ] || [ "$1" = "--clear-cache" ]; then
    "${PYTHON_CMD[@]}" "$@"
    exit $?
fi

# Print header
echo "╔════════════════════════════════════════════════════════════╗"
echo "║  🚀 EPUB/PDF TO MP3 CONVERTER - TURBO MODE               ║"
echo "╚════════════════════════════════════════════════════════════╝"
echo ""

# Check which flags are already present
ENGINE_PRESENT=0
VERBOSE_PRESENT=0
for arg in "$@"; do
    case "$arg" in
        --engine|--engine=*)
            ENGINE_PRESENT=1
            ;;
        --verbose|-v)
            VERBOSE_PRESENT=1
            ;;
    esac
done

EXTRA_ARGS=()
# Default to auto engine unless user specified one
if [ "$ENGINE_PRESENT" -eq 0 ]; then
    EXTRA_ARGS+=(--engine auto)
fi
if [ "$VERBOSE_PRESENT" -eq 0 ]; then
    EXTRA_ARGS+=(--verbose)
fi

exit_code=0

# Run through the dedicated CLI entrypoint so options like --menu can appear
# before the input path without being mistaken for a filename.
if "${PYTHON_CMD[@]}" "$@" "${EXTRA_ARGS[@]}"; then
    exit_code=0
else
    exit_code=$?
fi

if [ "$exit_code" -ne 0 ]; then
    exit "$exit_code"
fi

# Print completion
echo ""
echo "╔════════════════════════════════════════════════════════════╗"
echo "║  ✅ CONVERSION COMPLETE!                                  ║"
echo "╚════════════════════════════════════════════════════════════╝"
