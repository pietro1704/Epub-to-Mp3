#!/usr/bin/env bash
#
# EPUB/PDF to MP3 Audiobook Converter - Turbo Mode
#
# Usage:
#   ./convert book.epub
#   ./convert "path/to/book.pdf"
#   ./convert book.epub --chapter 5
#
# Features:
# - Auto hardware detection & optimization
# - Maximum speed settings (turbo mode)
# - Verbose output enabled
# - Smart engine selection (auto mode)
#

set -e  # Exit on error

# Check if special flags (--help, -h, --version)
if [ "$1" = "--help" ] || [ "$1" = "-h" ] || [ "$1" = "--version" ]; then
    python -m python_app.main "$@"
    exit 0
fi

# Check if book path provided
if [ $# -eq 0 ]; then
    echo "❌ Error: No book file specified"
    echo ""
    echo "Usage:"
    echo "  ./convert book.epub"
    echo "  ./convert \"path/to/book.pdf\""
    echo "  ./convert book.epub --chapter 5"
    echo ""
    exit 1
fi

# Check if file exists
BOOK_PATH="$1"
if [ ! -f "$BOOK_PATH" ]; then
    echo "❌ Error: File not found: $BOOK_PATH"
    exit 1
fi

# Print header
echo "╔════════════════════════════════════════════════════════════╗"
echo "║  🚀 EPUB/PDF TO MP3 CONVERTER - TURBO MODE               ║"
echo "╚════════════════════════════════════════════════════════════╝"
echo ""

# If the user did not pass --engine, default to edge (do NOT override explicit engines)
ENGINE_PRESENT=0
for arg in "$@"; do
    case "$arg" in
        --engine|--engine=*)
            ENGINE_PRESENT=1
            break
            ;;
    esac
done

EXTRA_ARGS=()
if [ "$ENGINE_PRESENT" -eq 0 ]; then
    EXTRA_ARGS+=(--engine edge)
fi

# Run conversion with optimal settings; append default engine only when absent
python -m python_app.main convert "$@" --verbose "${EXTRA_ARGS[@]}"

# Print completion
echo ""
echo "╔════════════════════════════════════════════════════════════╗"
echo "║  ✅ CONVERSION COMPLETE!                                  ║"
echo "╚════════════════════════════════════════════════════════════╝"
