{
  "fastMode": true,
  "language": "portuguese",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "ROOT=\"$(git rev-parse --show-toplevel)\" && \"$ROOT/.claude/hooks/session_start.sh\"",
            "timeout": 10,
            "async": true,
            "statusMessage": "Loading conversion history..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ROOT=\"$(git rev-parse --show-toplevel)\" && \"$ROOT/.claude/hooks/prompt_context.sh\"",
            "timeout": 8,
            "statusMessage": "Checking conversion status..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "ROOT=\"$(git rev-parse --show-toplevel)\" && \"$ROOT/.claude/hooks/bash_conversion.sh\"",
            "timeout": 10,
            "async": true,
            "if": "Bash(python*)"
          },
          {
            "type": "command",
            "command": "ROOT=\"$(git rev-parse --show-toplevel)\" && \"$ROOT/.claude/hooks/bash_conversion.sh\"",
            "timeout": 10,
            "async": true,
            "if": "Bash(mise run*)"
          },
          {
            "type": "command",
            "command": "ROOT=\"$(git rev-parse --show-toplevel)\" && \"$ROOT/.claude/hooks/ci_watch.sh\"",
            "timeout": 1800,
            "async": true,
            "if": "Bash(git push*)",
            "statusMessage": "Watching CI run..."
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "ROOT=\"$(git rev-parse --show-toplevel)\" && \"$ROOT/.claude/hooks/swift_test_after_edit.sh\"",
            "timeout": 120,
            "async": true,
            "statusMessage": "Re-running Swift tests after edit..."
          },
          {
            "type": "command",
            "command": "ROOT=\"$(git rev-parse --show-toplevel)\" && \"$ROOT/.claude/hooks/web_typecheck_after_edit.sh\"",
            "timeout": 60,
            "async": true,
            "statusMessage": "Re-running web typecheck after edit..."
          },
          {
            "type": "command",
            "command": "ROOT=\"$(git rev-parse --show-toplevel)\" && \"$ROOT/.claude/hooks/flutter_mirror_after_swift.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && pytest -q || true",
            "timeout": 120,
            "async": true,
            "statusMessage": "Running pytest after edit..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ROOT=\"$(git rev-parse --show-toplevel)\" && \"$ROOT/.claude/hooks/stop_status.sh\"",
            "timeout": 8
          },
          {
            "type": "command",
            "command": "ROOT=\"$(git rev-parse --show-toplevel)\" && \"$ROOT/.claude/hooks/test_coverage_gate.sh\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "ROOT=\"$(git rev-parse --show-toplevel)\" && \"$ROOT/.claude/hooks/xcode_build_smoke.sh\"",
            "timeout": 240,
            "async": true,
            "statusMessage": "Smoke build (xcodebuild macOS Debug)..."
          },
          {
            "type": "command",
            "command": "ROOT=\"$(git rev-parse --show-toplevel)\" && \"$ROOT/.claude/hooks/disk_pressure_check.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
