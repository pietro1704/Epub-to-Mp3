{
  "fastMode": true,
  "language": "portuguese",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/session_start.sh",
            "timeout": 10,
            "async": true,
            "statusMessage": "Loading conversion history..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/prompt_context.sh",
            "timeout": 8,
            "statusMessage": "Checking conversion status..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/bash_conversion.sh",
            "timeout": 10,
            "async": true,
            "if": "Bash(python*)"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/bash_conversion.sh",
            "timeout": 10,
            "async": true,
            "if": "Bash(mise run*)"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/ci_watch.sh",
            "timeout": 900,
            "async": true,
            "if": "Bash(git push*)",
            "statusMessage": "Watching CI run..."
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/swift_test_after_edit.sh",
            "timeout": 120,
            "async": true,
            "statusMessage": "Re-running Swift tests after edit..."
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/web_typecheck_after_edit.sh",
            "timeout": 60,
            "async": true,
            "statusMessage": "Re-running web typecheck after edit..."
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/flutter_mirror_after_swift.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "cd ${CLAUDE_PROJECT_DIR} && mise run test:unit",
            "timeout": 120,
            "async": true,
            "statusMessage": "Running pytest after edit..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/stop_status.sh",
            "timeout": 8
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/test_coverage_gate.sh",
            "timeout": 15
          },

          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/disk_pressure_check.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
